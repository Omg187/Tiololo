-- FIX: merged two separate Workspace loops into one with dedup table
local function handleSearchableText()
    local seen   = {}
    local result = {}
    for _, item in ipairs(Workspace:GetDescendants()) do
        if not seen[item] then
            if item:IsA("BasePart") and item.Name == "TPS" then
                seen[item] = true
                table.insert(result, item)
            elseif item:IsA("Model") and item.Name == "TPS" then
                for _, desc in ipairs(item:GetDescendants()) do
                    if desc:IsA("BasePart") and not seen[desc] then
                        seen[desc] = true
                        table.insert(result, desc)
                    end
                end
            end
        end
    end
    return result
end

-- ── Trajectory Prediction ─────────────────────────────────────────────────────
local trajectoryFolder      = Instance.new("Folder")
trajectoryFolder.Name       = "TrajectoryLine"
trajectoryFolder.Parent     = Workspace

-- FIX: removed shapeData[3]/shapeData[4] temp-variable abuse; using clean locals
local trajectoryParts = {}
for i = 1, 150 do
    local p        = Instance.new("Part")
    p.Anchored     = true
    p.CanCollide   = false
    p.Material     = Enum.Material.Neon
    p.Shape        = Enum.PartType.Cylinder
    p.CastShadow   = false
    p.Transparency = 1
    p.Parent       = trajectoryFolder
    trajectoryParts[i] = p
end

RunService.RenderStepped:Connect(function()
    if not loopTpData.Prediction then
        for _, p in ipairs(trajectoryParts) do p.Transparency = 1 end
        return
    end

    local char      = LocalPlayer.Character
    local hrp       = char and char:FindFirstChild("HumanoidRootPart")
    local originPos = hrp and hrp.Position or Vector3.new()

    -- Find closest ball to the player
    local closestBall, closestDist = nil, math.huge
    for _, ball in ipairs(searchableText) do
        if ball and ball.Parent then
            local d = (ball.Position - originPos).Magnitude
            if d < closestDist then
                closestDist = d
                closestBall = ball
            end
        end
    end

    if not closestBall or closestBall.AssemblyLinearVelocity.Magnitude < 2 then
        for _, p in ipairs(trajectoryParts) do p.Transparency = 1 end
        return
    end

    local pos       = closestBall.Position
    local vel       = closestBall.AssemblyLinearVelocity
    local gravity   = Vector3.new(0, -Workspace.Gravity, 0)
    local dt        = 0.05
    local hue0      = tick() * 0.8

    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { char, trajectoryFolder, closestBall }

    for i = 1, 150 do
        local nextPos = pos + vel * dt + 0.5 * gravity * dt * dt
        local hit     = Workspace:Raycast(pos, nextPos - pos, rayParams)
        local endPos  = hit and hit.Position or nextPos
        local segLen  = (endPos - pos).Magnitude
        local seg     = trajectoryParts[i]

        seg.Size         = Vector3.new(segLen, 0.45, 0.45)
        seg.CFrame       = CFrame.lookAt(pos, endPos)
            * CFrame.new(0, 0, -segLen / 2)
            * CFrame.Angles(0, math.pi / 2, 0)
        seg.Transparency = math.min(0.1 + i / 150, 0.8)
        seg.Color        = Color3.fromHSV((hue0 + i / 20) % 1, 1, 1)

        if hit then
            for j = i + 1, 150 do trajectoryParts[j].Transparency = 1 end
            break
        end

        vel = vel + gravity * dt
        pos = nextPos
    end
end)

