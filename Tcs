-- ── Helpers ───────────────────────────────────────────────────────────────────

-- Scale X/Z of a Vector3 (preserves Y arc of the shot)
local function scaleHorizontal(v, n)
    if typeof(v) == "Vector3" then
        return Vector3.new(v.X * n, v.Y, v.Z * n)
    end
    return v
end

-- Scale all axes with clamp (curve / spin)
local function scaleClamped(v, n)
    if typeof(v) == "Vector3" then
        return Vector3.new(
            math.clamp(v.X * n, -150, 150),
            math.clamp(v.Y * n, -150, 150),
            math.clamp(v.Z * n, -150, 150)
        )
    end
    return v
end

-- Returns true when the name indicates a pass / lob / cross (skip power/curve)
local function isPassContext(k)
    if not k or type(k) ~= "string" then return false end
    local lower = k:lower()
    return lower:find("pass") or lower:find("lob") or lower:find("cross")
end

-- Returns true when the name indicates a shot type
local function isShotContext(item)
    if not item or type(item) ~= "string" then return false end
    local lower = item:lower()
    if isPassContext(lower) then return false end
    for k in pairs(optionData) do
        if lower == k or lower:find(k, 1, true) then return true end
    end
    return false
end

-- Recursively apply Power/Curve multipliers to a FireServer payload table
local function applyModifiers(data, ctx)
    ctx = ctx or ""
    for k, item in pairs(data) do
        local key     = type(k) == "string" and k:lower() or ""
        local fullCtx = key ~= "" and (ctx .. " " .. key) or ctx

        if typeof(item) == "Vector3" then
            if curveKeywords[key] and loopTpData.CurveEnabled then
                data[k] = scaleClamped(item, loopTpData.CurveMult)
            elseif (powerKeywords[key] or key == "") and loopTpData.PowerEnabled then
                data[k] = scaleHorizontal(item, loopTpData.PowerMult)
            end
        elseif type(item) == "number" then
            if powerKeywords[key] and loopTpData.PowerEnabled then
                data[k] = item * loopTpData.PowerMult
            end
        elseif type(item) == "table" then
            applyModifiers(item, fullCtx)   -- FIX: was re-defining handler() twice inside namecall
        end
    end
end

