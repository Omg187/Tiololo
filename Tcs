-- ── Background Loop: ESP + Cooldown Removal ───────────────────────────────────
task.spawn(function()
    while task.wait(0.5) do
        searchableText = handleSearchableText()

        local reachOn = loopTpData.ReachEnabled or loopTpData.InfReach

        for _, ball in ipairs(searchableText) do
            -- Ball ESP
            local adorn = ball:FindFirstChild("TPS_ESP_Adornment")
            if loopTpData.BallESPEnabled then
                if not adorn then
                    local sph          = Instance.new("SphereHandleAdornment")
                    sph.Name           = "TPS_ESP_Adornment"
                    sph.Adornee        = ball
                    sph.Radius         = ball.Size.X / 2 + 0.1
                    sph.Color3         = Color3.fromRGB(255, 50, 50)
                    sph.Transparency   = 0.5
                    sph.AlwaysOnTop    = true
                    sph.ZIndex         = 10
                    sph.Parent         = ball
                end
            elseif adorn then
                adorn:Destroy()
            end

            -- Remove anti-dribble flags when reach is active
            if reachOn and ball.Parent then
                local rd = ball:FindFirstChild("ReactDecline")
                local dd = ball:FindFirstChild("DribbleDecline")
                if rd then rd:Destroy() end
                if dd then dd:Destroy() end
            end
        end

        -- Remove ownership cooldown instance
        if reachOn then
            pcall(function()
                local cd = Lighting:FindFirstChild("ChangeOwnerCooldown")
                if cd then cd:Destroy() end
            end)
        end
    end
end)

-- ── Heartbeat: Reach / LoopTP / AutoClaim / AutoCatch ────────────────────────
RunService.Heartbeat:Connect(function()
    local Character = LocalPlayer.Character
    if not Character then
        reachPart.Parent = nil
        flag = false
        return
    end

    local HRP      = Character:FindFirstChild("HumanoidRootPart")
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")

    -- Reach Visualizer
    if loopTpData.VisEnabled and HRP then
        local d          = loopTpData.ReachDistance * 2
        reachPart.Size   = Vector3.new(d, d, d)
        reachPart.CFrame = HRP.CFrame
        if reachPart.Parent ~= Workspace.CurrentCamera then
            reachPart.Parent = Workspace.CurrentCamera
        end
    else
        reachPart.Parent = nil
    end

    -- Loop TP to ball
    if loopTpData.LoopTP and HRP and #searchableText > 0 then
        local ball = searchableText[1]
        if ball and ball.Parent then
            local lookVec = Workspace.CurrentCamera.CFrame.LookVector
            local unit    = Vector3.new(lookVec.X, 0, lookVec.Z).Unit
            local dest    = ball.Position + Vector3.new(0, 1.2, 0)
            HRP.CFrame    = CFrame.lookAt(dest, dest + unit)
            HRP.AssemblyLinearVelocity = ball.AssemblyLinearVelocity
            if Humanoid then Humanoid.PlatformStand = false end
        end
    end

    if #searchableText == 0 or not HRP then return end

    local ball = searchableText[1]
    if not ball or not ball:IsA("BasePart") then return end

    local dist = (HRP.Position - ball.Position).Magnitude
    local now  = tick()

    -- Reach / firetouchinterest
    local reachOn = loopTpData.ReachEnabled or loopTpData.InfReach
    if reachOn and now - lastReachTick > 0.1 then   -- FIX: proper debounce
        lastReachTick = now
        local inRange = loopTpData.InfReach or dist <= loopTpData.ReachDistance
        if inRange then
            for _, limbName in ipairs({
                "Right Leg","Left Leg","Head","Torso",
                "UpperTorso","LowerTorso",
                "RightFoot","LeftFoot",
                "RightLowerLeg","LeftLowerLeg",
                "RightUpperLeg","LeftUpperLeg",
                "RightHand","LeftHand",
            }) do
                local limb = Character:FindFirstChild(limbName)
                if limb then
                    pcall(function()
                        firetouchinterest(ball, limb, 0)
                        firetouchinterest(ball, limb, 1)
                    end)
                end
            end
        end
    end

    -- Auto Claim
    if loopTpData.AutoClaim
        and dist <= loopTpData.AutoClaimDist
        and now - lastClaimTick > 0.1              -- FIX: proper debounce
    then
        lastClaimTick = now
        pcall(function()
            ReplicatedStorage.ChangeOwner:FireServer(ball, nil)
            ReplicatedStorage.ChangeValue:FireServer(ball)
        end)
    end

    -- Auto Catch
    if loopTpData.AutoCatch and dist <= loopTpData.AutoCatchDist and not flag then
        pcall(function()
            ReplicatedStorage.CatchBall:FireServer(ball)
        end)
    end
end)

-- ── Metatable Hooks ───────────────────────────────────────────────────────────
local mt           = getrawmetatable(game)
local mt_index     = mt.__index
local mt_newindex  = mt.__newindex
local mt_namecall  = mt.__namecall

setreadonly(mt, false)

-- __index — fake ball Position/CFrame to player foot for Reach
mt.__index = newcclosure(function(obj, key)
    if not checkcaller() then
        local keyStr = tostring(key)
        if keyStr == "Position" or keyStr == "CFrame" then
            local reachOn = loopTpData.ReachEnabled or loopTpData.InfReach
            if reachOn then
                local cam        = Workspace.CurrentCamera
                local camSubject = cam and cam.CameraSubject
                local camOnBall  = camSubject
                    and camSubject:IsA("BasePart")
                    and camSubject.Name == "TPS"

                if not loopTpData.BallControlActive and not camOnBall then
                    local isBall = obj.Name == "TPS" or table.find(searchableText, obj)
                    if isBall then
                        local char = LocalPlayer.Character
                        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local fakePos = hrp.Position
                                + hrp.CFrame.LookVector * 1.2
                                - Vector3.new(0, 1, 0)
                            if keyStr == "Position" then
                                return fakePos
                            else
                                local realCF = mt_index(obj, "CFrame")
                                return CFrame.new(fakePos) * (realCF - realCF.Position)
                            end
                        end
                    end
                end
            end
        end
    end
    return mt_index(obj, key)
end)

-- __newindex — intercept ball velocity writes for Power/Curve
mt.__newindex = newcclosure(function(obj, key, value)
    if typeof(value) == "Vector3" then
        local char = LocalPlayer.Character
        -- Never intercept character-owned parts
        if char and typeof(obj) == "Instance" and obj:IsDescendantOf(char) then
            return mt_newindex(obj, key, value)
        end

        local script     = getcallingscript and getcallingscript()
        local scriptName = script and script.Name:lower() or ""
        local parentName = script and script.Parent and script.Parent.Name:lower() or ""

        if isPassContext(scriptName) or isPassContext(parentName) then
            return mt_newindex(obj, key, value)
        end

        local isShot = isShotContext(scriptName) or lowerData[scriptName]
            or isShotContext(parentName) or lowerData[parentName]

        if isShot then
            local kl = key:lower()
            if loopTpData.PowerEnabled then
                if kl == "velocity" or kl == "assemblylinearvelocity" or kl == "vectorvelocity" then
                    value = scaleHorizontal(value, loopTpData.PowerMult)
                end
            end
            if loopTpData.CurveEnabled then
                if kl == "assemblyangularvelocity" or kl == "rotvelocity" then
                    value = scaleClamped(value, loopTpData.CurveMult)
                elseif kl == "angularvelocity" and obj:IsA("AngularVelocity") then
                    value = scaleClamped(value, loopTpData.CurveMult)
                elseif kl == "force" and (obj:IsA("BodyForce") or obj:IsA("VectorForce")) then
                    value = value * loopTpData.CurveMult
                elseif kl == "thrust" and obj:IsA("BodyThrust") then
                    value = value * loopTpData.CurveMult
                elseif kl == "torque" and obj:IsA("Torque") then
                    value = scaleClamped(value, loopTpData.CurveMult)
                end
            end
        end
    end
    return mt_newindex(obj, key, value)
end)

-- __namecall — intercept ApplyImpulse, ApplyAngularImpulse, FireServer
mt.__namecall = newcclosure(function(obj, ...)
    local args   = { ... }
    local method = getnamecallmethod()
    local script = getcallingscript and getcallingscript()
    local sName  = script and script.Name:lower() or ""
    local pName  = script and script.Parent and script.Parent.Name:lower() or ""

    -- ApplyImpulse → Power multiplier
    if method == "ApplyImpulse" and loopTpData.PowerEnabled then
        if not isPassContext(sName) then
            local isShot = isShotContext(sName) or lowerData[sName]
                or isShotContext(pName) or lowerData[pName]
            if isShot and typeof(args[1]) == "Vector3" then
                args[1] = scaleHorizontal(args[1], loopTpData.PowerMult)
            end
        end
        return mt_namecall(obj, unpackValues(args))
    end

    -- ApplyAngularImpulse → Curve multiplier
    if method == "ApplyAngularImpulse" and loopTpData.CurveEnabled then
        if not isPassContext(sName) then
            local isShot = isShotContext(sName) or lowerData[sName]
                or isShotContext(pName) or lowerData[pName]
            if isShot and typeof(args[1]) == "Vector3" then
                args[1] = scaleClamped(args[1], loopTpData.CurveMult)
            end
        end
        return mt_namecall(obj, unpackValues(args))
    end

    -- FireServer on RemoteEvent → applyModifiers to payload
    if method == "FireServer" and obj.ClassName == "RemoteEvent" then
        if isPassContext(sName) or isPassContext(obj.Name) then
            return mt_namecall(obj, unpackValues(args))
        end

        local isShot  = isShotContext(sName) or isShotContext(obj.Name)
        local isKnown = not isShot and (lowerData[sName] or lowerData[obj.Name:lower()])

        -- FIX: factored duplicate inner handler() into single applyModifiers()
        -- Deep-scan args when script name alone is inconclusive
        if not isShot and not isKnown then
            local function scanForShot(t)
                for k, v in pairs(t) do
                    local ks = type(k) == "string" and k or ""
                    local vs = type(v) == "string" and v or ""
                    if isPassContext(ks) or isPassContext(vs) then return false end
                    if isShotContext(ks) or isShotContext(vs) then return true end
                    if type(v) == "table" then
                        local found = scanForShot(v)
                        if found ~= nil then return found end
                    end
                end
            end
            local r = scanForShot(args)
            if r == false then return mt_namecall(obj, unpackValues(args)) end
            isShot = r or false
        end

        if isShot or isKnown then
            for i, item in ipairs(args) do
                if type(item) == "table" then
                    applyModifiers(item, obj.Name)
                elseif typeof(item) == "Vector3"
                    and loopTpData.PowerEnabled
                    and item.Magnitude < 3000
                then
                    args[i] = scaleHorizontal(item, loopTpData.PowerMult)
                elseif type(item) == "number"
                    and loopTpData.PowerEnabled
                    and item > 10 and item < 1000
                then
                    args[i] = item * loopTpData.PowerMult
                end
            end
        end
    end

    return mt_namecall(obj, unpackValues(args))
end)

setreadonly(mt, true)
-- ── End ───────────────────────────────────────────────────────────────────────

